# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. reCAPTCHA v3 site key registered for App Check. Leave empty to run without App Check.
VITE_RECAPTCHA_SITE_KEY=
# Optional. App Check debug token for localhost (Firebase console > App Check > Manage debug tokens).
VITE_APPCHECK_DEBUG_TOKEN=

# Optional. "true" uses the local Firestore emulator (npm run emulator) instead of the real database.
VITE_USE_EMULATOR=
